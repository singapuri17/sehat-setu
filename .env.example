# ─── Bhashini ASR — Hindi and Gujarati voice recognition ─────────────────────
# Get from: https://bhashini.ai → your app → API Keys
#
# BHASHINI_USER_ID   = the User ID shown under your app name (hex string)
# BHASHINI_UDYAT_KEY = the "Udyat Key" (partial: 21e56...33b1)
# BHASHINI_API_KEY   = the "Inference" key (partial: 1uuHi...8qHq)

BHASHINI_USER_ID=your-user-id-here
BHASHINI_UDYAT_KEY=your-udyat-key-here
BHASHINI_API_KEY=your-inference-key-here

# ─── OpenAI Whisper — English ASR fallback ────────────────────────────────────
# Used when the browser Web Speech API is unavailable (e.g. Firefox, kiosk mode).
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Instructions ─────────────────────────────────────────────────────────────
# Local dev:   cp .env.example .env  then fill in values
# Vercel:      Dashboard → Project → Settings → Environment Variables
# NEVER commit .env (it is in .gitignore)
