# ─── Voice / ASR ─────────────────────────────────────────────────────────────

# OpenAI Whisper — used for English speech recognition
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Bhashini Dhruva — used for Hindi (hi) and Gujarati (gu) ASR
# Register at: https://bhashini.gov.in/ulca/user/register
BHASHINI_API_KEY=your-dhruva-authorization-value
BHASHINI_PIPELINE_ID=your-pipeline-id

# ─── Instructions ─────────────────────────────────────────────────────────────
# 1. Copy this file:         cp .env.example .env
# 2. Fill in values above
# 3. For Vercel deployment:  add these in Vercel Dashboard → Project → Settings → Environment Variables
# 4. NEVER commit the real .env file (it is in .gitignore)
